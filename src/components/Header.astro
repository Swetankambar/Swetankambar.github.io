---
// Portions generated by GENAI: Claude Sonnet 4.5
import ThemeToggle from './ThemeToggle.astro';
import SearchButton from './SearchButton.astro';
---

<header>
	<nav>
		<div class="header-content">
			<div class="logo-section">
				<a href="/" class="logo-link">
					<img src="/images/logo.png" alt="Samvet" class="logo" />
					<div class="site-info">
						<h2 class="site-title">Samvet</h2>
						<p class="site-desc">Ensemble of my thoughts, experiments and observations</p>
					</div>
				</a>
			</div>
			
			<div class="nav-section">
				<ul class="nav-links">
					<li><a href="/junkomics">Junkomics</a></li>
					<li><a href="/perspectives">Perspectives</a></li>
					<li><a href="/running">Running It</a></li>
					<li><a href="/rf-experiments">RF Playground</a></li>
				</ul>
				<div class="header-actions">
					<SearchButton />
					<ThemeToggle />
				</div>
			</div>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--bg-color);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--border-color);
		transition: all 0.3s ease;
	}
	
	header::before {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--bg-color);
		opacity: 0.8;
		z-index: -1;
	}
	
	nav {
		max-width: 1200px;
		margin: 0 auto;
		padding: 1rem 2rem;
	}
	
	.header-content {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}
	
	.logo-section {
		flex-shrink: 0;
	}
	
	.logo-link {
		display: flex;
		align-items: center;
		gap: 1rem;
		text-decoration: none;
		color: inherit;
	}
	
	.logo {
		width: 50px;
		height: 50px;
		border-radius: 50%;
		transition: transform 0.3s ease;
	}
	
	.logo-link:hover .logo {
		transform: scale(1.05);
	}
	
	.site-info {
		text-align: left;
	}
	
	.site-title {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--text-color);
		transition: color 0.2s ease;
	}
	
	.logo-link:hover .site-title {
		color: var(--accent-color);
	}
	
	.site-desc {
		color: var(--text-secondary);
		margin: 0;
		font-size: 0.875rem;
	}
	
	.nav-section {
		display: flex;
		align-items: center;
		gap: 2rem;
	}
	
	.nav-links {
		list-style: none;
		padding: 0;
		display: flex;
		gap: 1.5rem;
		margin: 0;
	}
	
	.nav-links a {
		color: var(--text-color);
		text-decoration: none;
		font-weight: 500;
		font-size: 0.95rem;
		padding: 0.5rem 0.75rem;
		border-radius: 6px;
		transition: all 0.2s ease;
		position: relative;
	}
	
	.nav-links a:hover {
		color: var(--accent-color);
		background: var(--hover-bg);
	}
	
	.nav-links a::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 50%;
		transform: translateX(-50%) scaleX(0);
		width: 80%;
		height: 2px;
		background: var(--accent-color);
		transition: transform 0.2s ease;
	}
	
	.nav-links a:hover::after {
		transform: translateX(-50%) scaleX(1);
	}
	
	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-left: 0.5rem;
	}
	
	@media (max-width: 768px) {
		.header-content {
			flex-direction: column;
			align-items: flex-start;
			gap: 1rem;
		}
		
		.nav-section {
			width: 100%;
			flex-direction: column;
			align-items: flex-start;
			gap: 1rem;
		}
		
		.nav-links {
			flex-wrap: wrap;
			gap: 0.75rem;
		}
		
		.nav-links a {
			font-size: 0.875rem;
			padding: 0.4rem 0.6rem;
		}
		
		.site-desc {
			display: none;
		}
	}
</style>

