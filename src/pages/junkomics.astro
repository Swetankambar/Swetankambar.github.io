---
// Portions generated by GENAI: Claude Sonnet 4.5
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft && post.slug.startsWith('junkomics-'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
	title="Junkomics"
	description="Comics and visual stories"
>
	<section class="category-section">
		<div class="container">
			<div class="category-header">
				<h1>Junkomics</h1>
				<p class="category-desc">Comics and visual stories</p>
			</div>
			
			<div class="post-grid">
				{
					posts.map((post) => (
						<article class="post-card card">
							<a href={`/blog/${post.slug}/`} class="post-link">
								{post.data.heroImage && (
									<div class="post-image">
										<img src={post.data.heroImage} alt={post.data.title} loading="lazy" />
									</div>
								)}
								<div class="post-content">
									<h3 class="post-title">{post.data.title}</h3>
									<p class="post-description">{post.data.description}</p>
									<time class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</time>
								</div>
							</a>
						</article>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.category-section {
		padding: 3rem 0;
		min-height: 60vh;
	}
	
	.category-header {
		text-align: center;
		margin-bottom: 3rem;
	}
	
	h1 {
		font-size: 2.5rem;
		margin-bottom: 0.5rem;
		color: var(--text-color);
	}
	
	.category-desc {
		font-size: 1.125rem;
		color: var(--text-secondary);
	}
	
	.post-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 2rem;
	}
	
	.post-card {
		height: 100%;
		overflow: hidden;
	}
	
	.post-link {
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		height: 100%;
	}
	
	.post-image {
		width: 100%;
		height: 250px;
		overflow: hidden;
		margin: -1.5rem -1.5rem 1rem -1.5rem;
		border-radius: 12px 12px 0 0;
	}
	
	.post-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
		border-radius: 0;
	}
	
	.post-card:hover .post-image img {
		transform: scale(1.05);
	}
	
	.post-content {
		flex: 1;
		display: flex;
		flex-direction: column;
	}
	
	.post-title {
		font-size: 1.25rem;
		margin: 0 0 0.75rem 0;
		color: var(--text-color);
	}
	
	.post-description {
		color: var(--text-secondary);
		font-size: 0.95rem;
		line-height: 1.6;
		margin-bottom: 1rem;
		flex: 1;
	}
	
	.post-date {
		color: var(--text-tertiary);
		font-size: 0.875rem;
		margin-top: auto;
		padding-top: 1rem;
		border-top: 1px solid var(--border-color);
		display: block;
	}
	
	@media (max-width: 768px) {
		h1 {
			font-size: 2rem;
		}
		
		.post-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
		
		.post-image {
			height: 200px;
		}
	}
</style>
