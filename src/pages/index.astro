---
// Portions generated by GENAI: Claude Sonnet 4.5
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
	title="Samvet"
	description="Ensemble of my thoughts, experiments and observations"
>
	<section>
		<h2>Recent Posts</h2>
		<ul class="post-list">
			{
				posts.map((post) => (
					<li>
						<a href={`/blog/${post.slug}/`}>
							<h3 class="title">{post.data.title}</h3>
							<p class="date">
								Posted on <FormattedDate date={post.data.pubDate} />
							</p>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>

<style>
	section {
		max-width: 800px;
		margin: 2rem auto;
		padding: 0 2rem;
	}
	h2 {
		font-size: 2rem;
		margin-bottom: 2rem;
	}
	.post-list {
		list-style: none;
		padding: 0;
	}
	.post-list li {
		margin-bottom: 2rem;
	}
	.post-list a {
		text-decoration: none;
		color: inherit;
		display: block;
		padding: 1rem;
		border-radius: 8px;
		transition: background-color 0.2s;
	}
	.post-list a:hover {
		background-color: #f5f5f5;
	}
	.title {
		margin: 0 0 0.5rem 0;
		color: #333;
	}
	.date {
		color: #666;
		font-size: 0.875rem;
		margin: 0;
	}
</style>

